# ForgeMind Environment Configuration

# AI Provider Configuration (Server-side OpenAI-compatible API)
# Supports OpenAI, Azure OpenAI, OpenRouter, Local Ollama/vLLM, or Gemini OpenAI compatibility endpoint
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Optional: Supabase PostgreSQL & Auth Integration
# If omitted, ForgeMind automatically operates in local persistent mode using data/forgemind.json
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Environment Mode
NODE_ENV="development"

